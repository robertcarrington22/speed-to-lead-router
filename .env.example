# Copy to .env and load into your shell (or set in the launch config). Every value is optional.
# With nothing set, every integration runs in dry-run mode and logs what it would have written.

# Demo clock: 10 makes the 5-minute SLA run in 30 seconds
S2L_SPEED=1

# Slack incoming webhook for the alert channel (#inbound-hot)
SLACK_WEBHOOK_URL=

# Salesforce, option A: a session token (Setup > Connected Apps, or `sf org display`)
SFDC_ACCESS_TOKEN=
SFDC_INSTANCE_URL=https://acme.my.salesforce.com
# Salesforce, option B: OAuth client-credentials flow on a connected app with a run-as user
SFDC_CLIENT_ID=
SFDC_CLIENT_SECRET=
SFDC_LOGIN_URL=https://login.salesforce.com

# HubSpot private app token (scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.schemas.contacts.write)
HUBSPOT_PRIVATE_APP_TOKEN=

# Email for touch zero (Google Workspace app password works)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# SMS for touch zero
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
